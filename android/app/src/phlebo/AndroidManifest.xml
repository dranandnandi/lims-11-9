<?xml version="1.0" encoding="utf-8"?>
<!--
  Phlebo-only permissions. PhleboCollections shares the phlebotomist's live
  position with the lab while a collection is in progress (navigator.geolocation
  .watchPosition). Capacitor's BridgeWebChromeClient requests these at runtime
  when the WebView asks for location, but the runtime request is a no-op unless
  the permissions are declared here.

  Declared in the phlebo flavor rather than main so the patient app does not
  ship a location permission it never uses.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!--
      Nothing in PhleboCollections picks a photo or opens the camera, so the
      camera/media permissions inherited from the main manifest and the
      Capacitor camera plugin are stripped. READ_MEDIA_IMAGES would otherwise
      trigger the Play Console "Photo and Video Permissions" declaration.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

</manifest>
